# Obsidian workspace & caches (preserve community plugins, themes, and snippets)
.obsidian/workspace*
.obsidian/graph*
.obsidian/indexed*
.obsidian/cache*
.obsidian/plugins/*/data.json.bak
.obsidian/plugins/omnisearch/cache*
.obsidian/plugins/obsidian-tasks-plugin/cache*

# OS Generated Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# Temporary & Cache files
*.tmp
*.temp
*.bak
~$*

# Python scratch / cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
scratch/

# Large binary raw source files (Preserved locally, excluded from git to prevent HTTP 408 timeout & PC lag)
09_Source_Materials/
assets/*.mp4

# Static site dependencies & build artifacts
node_modules/
site/node_modules/
dist/
site/dist/
.astro/
site/.astro/
.cache/
site/.cache/

# Standalone PWC Project Git Repository
.git_pwc_standalone/

